{
  "name": "Hercules Security Rules",
  "version": "3.4.0",
  "description": "Список публичных правил с расширенным покрытием Mass Assignment и Rate Limiting",
  "rules": [
    {
      "id": "hardcoded-credentials",
      "message": "Обнаружены жестко закодированные учетные данные",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:password|pass|pwd|secret|api[_-]?key|token|access[_-]?token|refresh[_-]?token)\\s*[=:]\\s*['\"`][^'\"`\\s]{6,}['\"`]",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения или менеджер секретов",
      "languages": ["javascript", "typescript", "python", "java", "php", "ruby", "go", "csharp"]
    },
    {
      "id": "hardcoded-db-connection",
      "message": "Строка подключения к БД содержит пароль",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:mongodb|postgresql|mysql|redis|mongodb\\+srv):\\/\\/[^\\s'\"]+:[^\\s'\"]+@",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения для DATABASE_URL",
      "languages": ["javascript", "typescript", "python", "go", "java", "yaml", "env"]
    },
    {
      "id": "hardcoded-aws-credentials",
      "message": "AWS ключи доступа захардкожены",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:AKIA|ASIA)[0-9A-Z]{16}",
      "flags": "gi",
      "recommendation": "Используйте IAM роли или AWS Secrets Manager",
      "languages": ["javascript", "typescript", "python", "go", "java", "yaml", "terraform", "env"]
    },
    {
      "id": "private-key-exposure",
      "message": "Обнаружен приватный ключ",
      "severity": "critical",
      "type": "regex",
      "pattern": "-----BEGIN (?:RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY-----",
      "flags": "gi",
      "recommendation": "Храните приватные ключи в защищенном хранилище",
      "languages": ["all"]
    },
    {
      "id": "jwt-token-exposure",
      "message": "Обнаружен JWT токен",
      "severity": "high",
      "type": "regex",
      "pattern": "eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения для JWT токенов",
      "languages": ["all"]
    },
    {
      "id": "sql-injection",
      "message": "Потенциальная SQL инъекция (A03:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:execute|query|exec|raw)\\s*\\(\\s*['\"`][^'\"`]*\\+",
      "flags": "gi",
      "recommendation": "Используйте параметризованные запросы или ORM",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp"]
    },
    {
      "id": "command-injection",
      "message": "Потенциальная инъекция команд (A03:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:exec|system|popen|Runtime\\.exec|subprocess\\.call|os\\.system)\\s*\\([^)]*\\+(?:req|request|params|input|data)",
      "flags": "gi",
      "recommendation": "Избегайте выполнения команд с пользовательским вводом, используйте белые списки команд",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "dangerous-code-execution",
      "message": "Использование eval() или аналогичных функций",
      "severity": "critical",
      "type": "regex",
      "pattern": "\\b(?:eval|Function|setTimeout|setInterval)\\s*\\([^)]*(?:req|request|params|body|query|input)",
      "flags": "gi",
      "recommendation": "Избегайте динамического выполнения кода, используйте безопасные парсеры",
      "languages": ["javascript", "typescript", "python"]
    },
    {
      "id": "xss-vulnerability",
      "message": "Потенциальная XSS уязвимость (A07:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:innerHTML|outerHTML|document\\.write|insertAdjacentHTML)\\s*=\\s*(?:req|request|params|query|body|\\+.*input)",
      "flags": "gi",
      "recommendation": "Используйте textContent/innerText или DOMPurify для санации HTML",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "path-traversal",
      "message": "Потенциальный обход пути (Path Traversal)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:fs\\.(?:readFile|writeFile|readdir|unlink|createReadStream|createWriteStream))\\s*\\([^)]*\\.\\./",
      "flags": "gi",
      "recommendation": "Валидируйте пути, используйте path.resolve() и проверку на '..'",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "ssrf-vulnerability",
      "message": "SSRF: запрос к пользовательскому URL (A10:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:axios\\.(?:get|post|put|delete|request)|fetch|http\\.get|https\\.get|requests\\.get|urllib\\.request|HttpClient)\\(\\s*(?:req\\.query\\.\\w+|req\\.body\\.\\w+|req\\.params\\.\\w+|url|target|uri|endpoint)\\s*\\)",
      "flags": "gi",
      "recommendation": "Валидируйте URL по белому списку доменов, блокируйте внутренние IP",
      "languages": ["javascript", "typescript", "python", "java", "go", "csharp"]
    },
    {
      "id": "cloud-metadata-ssrf",
      "message": "SSRF: доступ к облачным метаданным",
      "severity": "critical",
      "type": "regex",
      "pattern": "169\\.254\\.169\\.254|metadata\\.google\\.internal|100\\.100\\.100\\.200|\\[\\.\\]|\\[\\.\\]\\d+",
      "flags": "gi",
      "recommendation": "Блокируйте доступ к внутренним IP и облачным метаданным",
      "languages": ["all"]
    },
    {
      "id": "ssrf-file-protocol",
      "message": "SSRF: доступ к file:// протоколу",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:fetch|axios\\.get|http\\.get|requests\\.get)\\s*\\(['\"`]file://",
      "flags": "gi",
      "recommendation": "Блокируйте file://, gopher://, dict:// протоколы",
      "languages": ["javascript", "typescript", "python", "java", "go"]
    },
    {
      "id": "open-redirect",
      "message": "Потенциальный открытый редирект (A01:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:redirect|res\\.redirect|redirect_to)\\s*\\([^)]*(?:req|request|params|headers\\[['\"]host['\"]\\]|headers\\.host|return_to|next|callback)",
      "flags": "gi",
      "recommendation": "Валидируйте URL редиректа по белому списку или используйте относительные пути",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp"]
    },
    {
      "id": "insecure-deserialization",
      "message": "Небезопасная десериализация (A08:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:pickle\\.loads|yaml\\.load\\(|unserialize|ObjectInputStream|readObject|XmlSerializer|BinaryFormatter)\\([^)]*(?!.*safe)",
      "flags": "gi",
      "recommendation": "Используйте JSON с валидацией схемы или форматы с безопасной десериализацией",
      "languages": ["python", "java", "php", "ruby", "csharp", "go"]
    },
    {
      "id": "weak-cryptography",
      "message": "Слабый криптографический алгоритм (A02:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "\\b(?:MD5|SHA-?1|DES|RC4|RSA1024)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте AES-256-GCM, bcrypt, Argon2 или SHA-256/SHA-3",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "csharp", "ruby"]
    },
    {
      "id": "http-instead-https",
      "message": "Использование HTTP вместо HTTPS (A02:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:fetch|axios|http\\.get|https\\.get|requests\\.get|urllib\\.request)\\s*\\([^)]*\\bhttp:\\/\\/(?!localhost|127\\.0\\.0\\.1|::1|\\[\\.\\])",
      "flags": "gi",
      "recommendation": "Всегда используйте HTTPS в production окружении",
      "languages": ["javascript", "typescript", "python", "go", "java", "csharp", "php"]
    },
    {
      "id": "cors-wildcard",
      "message": "CORS заголовок Access-Control-Allow-Origin: * с чувствительными данными",
      "severity": "medium",
      "type": "regex",
      "pattern": "Access-Control-Allow-Origin\\s*:\\s*\\*",
      "flags": "gi",
      "recommendation": "Укажите конкретные разрешенные домены, не используйте '*' с credentials",
      "languages": ["all"]
    },
    {
      "id": "csrf-missing",
      "message": "Отсутствует защита от CSRF (A01:2021)",
      "severity": "medium",
      "type": "regex",
      "pattern": "(?:<form[^>]*method=[\"']post[\"'][^>]*>)(?![\\s\\S]{0,200}(?:csrf|_token|nonce))",
      "flags": "gi",
      "recommendation": "Внедрите CSRF токены или SameSite cookie с проверкой Origin/Referer",
      "languages": ["html", "javascript", "typescript", "python", "php", "java"]
    },
    {
      "id": "log-sensitive-data",
      "message": "Логирование чувствительных данных (A09:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:console\\.log|logger\\.(?:info|debug|warn|error|log)|System\\.out\\.println|logging\\.info)\\s*\\([^)]*(?:password|token|secret|api_key|authorization|cookie|credit_card)",
      "flags": "gi",
      "recommendation": "Никогда не логируйте пароли, токены, PII данные",
      "languages": ["javascript", "typescript", "python", "java", "go", "csharp", "php", "ruby"]
    },
    {
      "id": "debug-mode-production",
      "message": "Режим отладки включен (A05:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:DEBUG|NODE_ENV|APP_DEBUG|DJANGO_DEBUG|FLASK_DEBUG|ASPNETCORE_ENVIRONMENT)\\s*=\\s*(?:True|true|1|'development'|'dev'|Development)",
      "flags": "gim",
      "recommendation": "Отключите режим отладки и детальные ошибки в production",
      "languages": ["python", "javascript", "typescript", "java", "php", "env", "csharp"]
    },
    {
      "id": "prototype-pollution",
      "message": "Потенциальное загрязнение прототипа",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:merge|extend|clone|copy|assign)\\s*\\([^,]*,\\s*(?:req\\.body|req\\.query|params|input)",
      "flags": "gi",
      "recommendation": "Используйте Object.create(null), валидацию JSON Schema или freeze",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "mass-assignment",
      "message": "Массовое присваивание (A01:2021) - эскалация привилегий",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:Model\\.(?:create|update|insert|upsert)|\\w+\\.(?:save|update|patch|assignAttributes)\\s*\\(\\s*req\\.body|req\\.body\\s*(?:=|:)\\s*\\w+|Object\\.assign\\([^,]+,\\s*req\\.(?:body|query)|BeanUtils\\.copyProperties\\([^,]+,\\s*\\w+\\)|c\\.(?:Bind|ShouldBind|BindJSON)\\(&\\w+\\)|serializer\\.save\\(\\s*data=\\s*request\\.data|db\\.(?:Create|Save|Updates|FirstOrCreate)\\s*\\(\\w+\\)|\\w+\\.fill\\s*\\(req\\.(?:body|params)\\)|\\$set\\s*:\\s*req\\.body|fields\\s*=\\s*['\"]__all__['\"])",
      "flags": "gi",
      "recommendation": "Используйте DTO/FormRequest с явными разрешенными полями, никогда не принимайте весь req.body",
      "languages": ["javascript", "typescript", "python", "ruby", "php", "java", "go", "csharp"]
    },
    {
      "id": "mass-assignment-critical-fields",
      "message": "КРИТИЧЕСКОЕ: Массовое присваивание полей привилегий",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:Model\\.(?:create|update|insert)|\\w+\\.(?:save|update)\\s*\\(\\s*req\\.body|c\\.Bind\\(&\\w+\\)|serializer\\.save|\\w+\\.update).{0,100}(?:isAdmin|is_admin|role|permissions|isRoot|superuser|access_level|scopes|user_type|account_type|privilege)",
      "flags": "gi",
      "recommendation": "Поля привилегий НИКОГДА не должны приходить из input. Устанавливайте их сервером",
      "languages": ["javascript", "typescript", "python", "ruby", "php", "java", "go", "csharp"]
    },
    {
      "id": "insecure-cookie-config",
      "message": "Небезопасная конфигурация cookie",
      "severity": "medium",
      "type": "regex",
      "pattern": "cookie\\s*\\([^)]*(?!(?:Secure|secure|HttpOnly|httpOnly|SameSite))",
      "flags": "gi",
      "recommendation": "Установите Secure, HttpOnly, SameSite=Strict/Lax на всех production cookie",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "csharp"]
    },
    {
      "id": "go-race-condition",
      "message": "Потенциальная гонка данных в Go",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:(?:\\w+\\s*:?=)\\s*\\w+\\.\\w+\\s*\\{[^}]*\\}\\s*\\)?)\\s*go\\s+func\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте sync.Mutex, sync.RWMutex или атомарные операции с sync/atomic",
      "languages": ["go"]
    },
    {
      "id": "go-exec-command",
      "message": "Выполнение команд с пользовательским вводом",
      "severity": "critical",
      "type": "regex",
      "pattern": "exec\\.Command(?:Context)?\\s*\\([^)]*\\+",
      "flags": "gi",
      "recommendation": "Избегайте конкатенации строк в exec.Command, используйте аргументы списком",
      "languages": ["go"]
    },
    {
      "id": "python-eval",
      "message": "Использование eval() или exec()",
      "severity": "critical",
      "type": "regex",
      "pattern": "\\b(?:eval|exec|compile)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте ast.literal_eval() или json.loads() для безопасного парсинга",
      "languages": ["python"]
    },
    {
      "id": "python-pickle",
      "message": "Использование pickle для недоверенных данных",
      "severity": "critical",
      "type": "regex",
      "pattern": "pickle\\.(?:loads|load|Unpickler)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте JSON или другие безопасные форматы сериализации",
      "languages": ["python"]
    },
    {
      "id": "python-subprocess-shell",
      "message": "shell=True в subprocess",
      "severity": "critical",
      "type": "regex",
      "pattern": "subprocess\\.(?:call|Popen|run|check_output)\\s*\\([^)]*shell\\s*=\\s*True",
      "flags": "gi",
      "recommendation": "Избегайте shell=True, передавайте аргументы списком",
      "languages": ["python"]
    },
    {
      "id": "python-yaml-load",
      "message": "yaml.load() без SafeLoader",
      "severity": "high",
      "type": "regex",
      "pattern": "yaml\\.load\\s*\\([^)]*(?!(?:SafeLoader|FullLoader|CSafeLoader))",
      "flags": "gi",
      "recommendation": "Всегда используйте yaml.safe_load() или yaml.load(..., Loader=yaml.SafeLoader)",
      "languages": ["python"]
    },
    {
      "id": "iac-tf-admin-permissions",
      "message": "Административные привилегии в IAM",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:AdministratorAccess|admin\\*|\\*:\\*|arn:aws:iam::\\*:user/\\*|aws:PrincipalArn)",
      "flags": "gi",
      "recommendation": "Используйте принцип наименьших привилегий, избегайте wildcard *",
      "languages": ["terraform", "hcl"]
    },
    {
      "id": "iac-tf-open-security-group",
      "message": "Security group открыта для всего мира",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:cidr_blocks?|ipv6_cidr_blocks?)\\s*=\\s*\\[\\s*[\"']0\\.0\\.0\\.0/0[\"']",
      "flags": "gi",
      "recommendation": "Ограничьте доступ конкретными IP диапазонами или VPC",
      "languages": ["terraform", "hcl"]
    },
    {
      "id": "iac-tf-plaintext-secrets",
      "message": "Секреты в plaintext в Terraform",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:password|secret|api_key|access_key|private_key)\\s*=\\s*[\"'][^\"']{8,}[\"'](?!.*(?:var\\.|data\\.|aws_secretsmanager|vault))",
      "flags": "gi",
      "recommendation": "Используйте переменные, Secrets Manager или Vault",
      "languages": ["terraform", "hcl"]
    },
    {
      "id": "iac-k8s-privileged-container",
      "message": "Привилегированный контейнер",
      "severity": "critical",
      "type": "regex",
      "pattern": "privileged\\s*:\\s*true",
      "flags": "gi",
      "recommendation": "Установите privileged: false, используйте securityContext с capabilities",
      "languages": ["yaml"]
    },
    {
      "id": "iac-k8s-host-network",
      "message": "hostNetwork включен",
      "severity": "critical",
      "type": "regex",
      "pattern": "hostNetwork\\s*:\\s*true",
      "flags": "gi",
      "recommendation": "Избегайте hostNetwork, используйте порты NodePort или LoadBalancer",
      "languages": ["yaml"]
    },
    {
      "id": "iac-k8s-run-as-root",
      "message": "Контейнер от root пользователя",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:runAsNonRoot\\s*:\\s*false|runAsUser\\s*:\\s*0)",
      "flags": "gim",
      "recommendation": "Установите runAsNonRoot: true, runAsUser: 1000+",
      "languages": ["yaml"]
    },
    {
      "id": "iac-k8s-host-path-volume",
      "message": "Использование hostPath тома",
      "severity": "critical",
      "type": "regex",
      "pattern": "hostPath\\s*:\\s*\\n\\s+path\\s*:",
      "flags": "gi",
      "recommendation": "Используйте persistentVolumeClaims вместо hostPath",
      "languages": ["yaml"]
    },
    {
      "id": "iac-docker-latest-tag",
      "message": "Тег 'latest' в образе",
      "severity": "medium",
      "type": "regex",
      "pattern": ":latest\\b",
      "flags": "gi",
      "recommendation": "Используйте конкретную версию тега (например, v1.2.3 или хеш)",
      "languages": ["yaml", "dockerfile"]
    },
    {
      "id": "config-env-exposure",
      "message": "Файл .env в репозитории",
      "severity": "critical",
      "type": "regex",
      "pattern": "\\.env$",
      "flags": "gi",
      "recommendation": "Добавьте .env в .gitignore, используйте .env.example",
      "languages": ["env"]
    },
    {
      "id": "config-json-secrets",
      "message": "Секреты в JSON конфигурации",
      "severity": "critical",
      "type": "regex",
      "pattern": "\"(?:password|secret|token|api_key|privateKey|clientSecret)\"\\s*:\\s*\"[^\"]{8,}\"",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения или внешние секреты",
      "languages": ["json"]
    },
    {
      "id": "owasp-broken-access-control",
      "message": "Нарушение контроля доступа (A01:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:if\\s*\\([^)]*(?:user\\.role|isAdmin|is_admin)\\s*==?\\s*(?:false|0|'user')\\)|role\\s*=\\s*['\"]user['\"])",
      "flags": "gi",
      "recommendation": "Проверяйте права на сервере для каждого запроса, никогда не доверяйте клиенту",
      "languages": ["javascript", "typescript", "python", "go", "java", "csharp"]
    },
    {
      "id": "owasp-security-misconfig",
      "message": "Ошибка конфигурации безопасности (A05:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:debug\\s*=\\s*true|stack[_\\s]?trace(?!.*false)|show_errors\\s*=\\s*on|expose_php\\s*=\\s*On)",
      "flags": "gi",
      "recommendation": "Отключите отладку, детальные ошибки и информационные заголовки в production",
      "languages": ["php", "python", "javascript", "java", "csharp"]
    },
    {
      "id": "owasp-ssrf",
      "message": "Потенциальная SSRF (A10:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:fetch\\s*\\([^)]*req\\.|http\\.get\\s*\\([^)]*query|axios\\([^)]*body\\.url|requests\\.get\\(params\\[)",
      "flags": "gi",
      "recommendation": "Валидируйте URL по белому списку доменов, блокируйте URL с IP адресами",
      "languages": ["javascript", "typescript", "python", "java", "go", "php", "ruby", "csharp"]
    },
    {
      "id": "todo-comment",
      "message": "TODO/FIXME комментарий",
      "severity": "info",
      "type": "regex",
      "pattern": "(?:\\/\\/|#|\\/\\*|<!--)\\s*(?:TODO|FIXME|XXX|HACK|BUG|OPTIMIZE)",
      "flags": "gi",
      "recommendation": "Выполните или задокументируйте задачу перед релизом",
      "languages": ["all"]
    },
    {
      "id": "missing-resources",
      "message": "Отсутствуют ресурсы контейнера",
      "severity": "medium",
      "type": "regex",
