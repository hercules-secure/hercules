{
  "name": "Hercules Security Rules",
  "version": "2.0.0",
  "description": "Список публичных правил",
  "rules": [
    {
      "id": "hardcoded-credentials",
      "message": "Обнаружены жестко закодированные учетные данные",
      "severity": "critical",
      "type": "regex",
      "pattern": "(password|pass|pwd|secret|api_key|apikey|apiKey|token|access_token|refresh_token)\\s*[=:]\\s*['\"`][^'\"`\\s]{6,}['\"`]",
      "recommendation": "Используйте переменные окружения, менеджер секретов или хранилище для учетных данных",
      "languages": ["javascript", "typescript", "python", "java", "php", "ruby", "go", "csharp"]
    },
    {
      "id": "hardcoded-db-connection",
      "message": "Строка подключения к БД содержит пароль и захардкожена в коде",
      "severity": "critical",
      "type": "regex",
      "pattern": "(mongodb|postgresql|mysql|redis|mongodb\\+srv):\\/\\/[^\\s'\"]+:[^\\s'\"]+@",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения для DATABASE_URL",
      "languages": ["javascript", "typescript", "python", "go", "java", "yaml", "env"]
    },
    {
      "id": "hardcoded-aws-credentials",
      "message": "AWS ключи доступа захардкожены в коде",
      "severity": "critical",
      "type": "regex",
      "pattern": "(AKIA|ASIA)[0-9A-Z]{16}|aws_access_key_id\\s*[:=]\\s*[\"'][^\"']+[\"']",
      "flags": "gi",
      "recommendation": "Используйте IAM роли, AWS Secrets Manager или переменные окружения",
      "languages": ["javascript", "typescript", "python", "go", "java", "yaml", "terraform", "env"]
    },
    {
      "id": "private-key-exposure",
      "message": "Обнаружен приватный ключ в коде или конфигурации",
      "severity": "critical",
      "type": "regex",
      "pattern": "-----BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY-----",
      "flags": "gi",
      "recommendation": "Храните приватные ключи в защищенном хранилище с правильными правами доступа",
      "languages": ["all"]
    },
    {
      "id": "jwt-token-exposure",
      "message": "Обнаружен JWT токен в коде или конфигурации",
      "severity": "high",
      "type": "regex",
      "pattern": "eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+",
      "flags": "gi",
      "recommendation": "Никогда не коммитьте JWT токены - используйте переменные окружения",
      "languages": ["all"]
    },
    {
      "id": "url-credentials",
      "message": "URL содержит встроенные учетные данные",
      "severity": "high",
      "type": "regex",
      "pattern": "(https?|ftp|mongodb|postgresql|mysql|redis):\\/\\/[^:]+:[^@]+@",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения для учетных данных",
      "languages": ["all"]
    },
    {
      "id": "sql-injection",
      "message": "Обнаружена уязвимость SQL инъекции",
      "severity": "critical",
      "type": "regex",
      "pattern": "(execute|query|exec|executeQuery|executeUpdate|raw|fromSQL)\\s*\\(\\s*['\"`](SELECT|INSERT|UPDATE|DELETE|CREATE|DROP|ALTER)[^'\"`]*\\+\\s*|(execute|executemany)\\s*\\(\\s*f['\"].*\\{[^}]+\\}.*['\"]",
      "flags": "gi",
      "recommendation": "Используйте параметризованные запросы или подготовленные выражения",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp"]
    },
    {
      "id": "nosql-injection",
      "message": "Потенциальная уязвимость NoSQL инъекции",
      "severity": "critical",
      "type": "regex",
      "pattern": "(\\$where|\\$regex|\\$ne|\\$gt|\\$lt|\\$in|\\$or|\\$and).*(req\\.|request\\.|params\\.|query\\.|body)",
      "flags": "gi",
      "recommendation": "Валидируйте и очищайте пользовательский ввод. Используйте параметризованные запросы",
      "languages": ["javascript", "typescript", "python", "java"]
    },
    {
      "id": "command-injection",
      "message": "Обнаружена уязвимость внедрения команд",
      "severity": "critical",
      "type": "regex",
      "pattern": "(exec|execSync|spawn|fork|system|popen|Runtime\\.exec|ProcessBuilder|os\\.system|subprocess\\.call|subprocess\\.Popen)\\s*\\(\\s*[\"'`][^\"'`]*\\+(req\\.|request\\.|params\\.|query\\.)",
      "flags": "gi",
      "recommendation": "Избегайте выполнения системных команд с пользовательским вводом; используйте безопасные API",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "dangerous-code-execution",
      "message": "Использование eval() или аналогичных функций может привести к инъекции кода",
      "severity": "critical",
      "type": "regex",
      "pattern": "\\b(?:eval|Function|exec)\\s*\\([^)]*(req\\.|request\\.|params|query|body|input)",
      "flags": "gi",
      "recommendation": "Избегайте динамического выполнения кода. Используйте JSON.parse() для данных",
      "languages": ["javascript", "typescript", "python"]
    },
    {
      "id": "xss-vulnerability",
      "message": "Обнаружена уязвимость XSS",
      "severity": "high",
      "type": "regex",
      "pattern": "(innerHTML|outerHTML|insertAdjacentHTML|document\\.write|document\\.writeln)\\s*[=:]\\s*[^=]*(req\\.|request\\.|params|query|body|input)",
      "flags": "gi",
      "recommendation": "Используйте textContent или innerText вместо innerHTML, или очищайте пользовательский ввод с помощью DOMPurify",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "path-traversal",
      "message": "Обнаружена уязвимость обхода пути (Path Traversal)",
      "severity": "high",
      "type": "regex",
      "pattern": "(fs\\.(readFile|writeFile|readdir|unlink|readFileSync|writeFileSync|createReadStream|createWriteStream)|open)\\s*\\([^)]*(req\\.|request\\.|params|query|body)[^)]*\\.\\./",
      "flags": "gi",
      "recommendation": "Валидируйте пути к файлам; используйте path.resolve() и проверяйте корневой путь",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "ssrf-vulnerability",
      "message": "Обнаружена потенциальная уязвимость SSRF",
      "severity": "critical",
      "type": "regex",
      "pattern": "(fetch|axios\\.(get|post)|http\\.get|https\\.get|requests\\.(get|post)|urllib\\.request|httpx\\.(get|post))\\s*\\([^)]*(req\\.|request\\.|params|query|body)",
      "flags": "gi",
      "recommendation": "Валидируйте URL по белому списку доменов; блокируйте доступ к внутренним IP-адресам",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "cloud-metadata-ssrf",
      "message": "Обнаружен потенциальный доступ к облачным метаданным через SSRF",
      "severity": "critical",
      "type": "regex",
      "pattern": "169\\.254\\.169\\.254|metadata\\.google\\.internal|100\\.100\\.100\\.200",
      "flags": "gi",
      "recommendation": "Блокируйте доступ к внутренним IP облачных метаданных",
      "languages": ["all"]
    },
    {
      "id": "open-redirect",
      "message": "Обнаружена уязвимость открытого редиректа",
      "severity": "medium",
      "type": "regex",
      "pattern": "(redirect|res\\.redirect|redirect_to|Redirect)\\s*\\([^)]*(req\\.|request\\.|params|query)",
      "flags": "gi",
      "recommendation": "Валидируйте URL редиректа по белому списку разрешенных доменов",
      "languages": ["javascript", "typescript", "python", "java", "ruby", "php", "go"]
    },
    {
      "id": "insecure-deserialization",
      "message": "Обнаружена небезопасная десериализация",
      "severity": "critical",
      "type": "regex",
      "pattern": "(pickle\\.loads|pickle\\.load|ObjectInputStream\\.readObject|yaml\\.load\\(|unserialize|deserialize)\\s*\\(",
      "flags": "gi",
      "recommendation": "Избегайте десериализации недоверенных данных; используйте JSON с валидацией схемы",
      "languages": ["python", "java", "php", "ruby", "javascript"]
    },
    {
      "id": "weak-cryptography",
      "message": "Обнаружен слабый криптографический алгоритм",
      "severity": "high",
      "type": "regex",
      "pattern": "\\b(MD5|SHA1|md5|sha1|DES|RC4|AES/ECB|ECB)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте надежные алгоритмы: AES-256-GCM, bcrypt, argon2, SHA-256",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp"]
    },
    {
      "id": "http-instead-https",
      "message": "Использование HTTP вместо HTTPS. Данные передаются в открытом виде",
      "severity": "high",
      "type": "regex",
      "pattern": "http:\\/\\/(?!localhost|127\\.0\\.0\\.1)",
      "flags": "gi",
      "recommendation": "Всегда используйте HTTPS. Настройте HSTS",
      "languages": ["html", "javascript", "typescript", "python", "go", "java"]
    },
    {
      "id": "websocket-plain",
      "message": "Использование небезопасного WebSocket соединения (ws://)",
      "severity": "high",
      "type": "regex",
      "pattern": "new\\s+WebSocket\\s*\\(\\s*['\"]ws:\\/\\/",
      "flags": "gi",
      "recommendation": "Используйте защищенное WebSocket соединение wss://",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "cors-wildcard",
      "message": "CORS заголовок Access-Control-Allow-Origin: *",
      "severity": "medium",
      "type": "regex",
      "pattern": "Access-Control-Allow-Origin\\s*:\\s*\\*",
      "flags": "gi",
      "recommendation": "Укажите конкретные разрешенные домены, не используйте *",
      "languages": ["all"]
    },
    {
      "id": "csrf-missing",
      "message": "Отсутствует защита от CSRF",
      "severity": "medium",
      "type": "regex",
      "pattern": "<form[^>]*(?!.*csrf|.*_token)",
      "flags": "gi",
      "recommendation": "Внедрите CSRF токены для операций, изменяющих состояние",
      "languages": ["html"]
    },
    {
      "id": "missing-rate-limit",
      "message": "Отсутствует ограничение количества запросов",
      "severity": "medium",
      "type": "regex",
      "pattern": "app\\.(post|put|delete)\\s*\\(['\"][^'\"]*(login|auth|register|reset)[^'\"]*['\"]\\)(?!.*rate.*limit|.*throttle)",
      "flags": "gi",
      "recommendation": "Реализуйте rate limiting для защиты от атак перебора",
      "languages": ["javascript", "typescript", "python", "java", "php"]
    },
    {
      "id": "log-sensitive-data",
      "message": "Обнаружено логирование чувствительных данных",
      "severity": "high",
      "type": "regex",
      "pattern": "(log\\(.*(password|pass|token|secret|credit|card|ssn|key)|logger\\.(info|debug|error|warn)\\(.*(password|pass|token|secret))",
      "flags": "gi",
      "recommendation": "Избегайте логирования чувствительной информации",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby"]
    },
    {
      "id": "debug-mode-production",
      "message": "Режим отладки включен в production",
      "severity": "high",
      "type": "regex",
      "pattern": "(DEBUG\\s*=\\s*True|debug\\s*=\\s*true|app\\.debug\\s*=\\s*true|NODE_ENV\\s*=\\s*['\"]development['\"])",
      "flags": "gi",
      "recommendation": "Отключите режим отладки в production среде",
      "languages": ["python", "javascript", "typescript", "java", "php"]
    },
    {
      "id": "unsafe-file-upload",
      "message": "Обнаружена небезопасная загрузка файлов",
      "severity": "high",
      "type": "regex",
      "pattern": "(multer|upload\\.single|upload\\.array|upload\\.fields)[^}]*(?!(validate|check|allowed|extension|mime|size))",
      "flags": "gi",
      "recommendation": "Валидируйте тип файла, размер и переименовывайте файлы",
      "languages": ["javascript", "typescript", "python", "java", "php"]
    },
    {
      "id": "prototype-pollution",
      "message": "Потенциальное загрязнение прототипа при merge объектов",
      "severity": "high",
      "type": "regex",
      "pattern": "(merge|extend|cloneDeep)\\s*\\([^,]*,\\s*(req\\.|request\\.|params\\.|body)|__proto__|constructor\\.prototype",
      "flags": "gi",
      "recommendation": "Используйте Object.create(null) или валидацию ключей",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "env-file-repository",
      "message": "Файл .env обнаружен в репозитории. Это нарушение безопасности",
      "severity": "high",
      "type": "regex",
      "pattern": ".*",
      "flags": "g",
      "recommendation": "Добавьте .env в .gitignore и удалите его из репозитория",
      "languages": ["env"]
    },
    {
      "id": "graphql-introspection",
      "message": "GraphQL introspection включена в production",
      "severity": "medium",
      "type": "regex",
      "pattern": "__schema|__type",
      "flags": "gi",
      "recommendation": "Отключите introspection в production",
      "languages": ["graphql"]
    },
    {
      "id": "stack-trace-exposure",
      "message": "Вывод стека ошибок в production",
      "severity": "medium",
      "type": "regex",
      "pattern": "(app\\.debug\\s*=\\s*true|DEBUG\\s*=\\s*true|NODE_ENV\\s*=\\s*['\"]development['\"])",
      "flags": "gi",
      "recommendation": "Отключите debug режим в production",
      "languages": ["javascript", "typescript", "python", "php"]
    },
    {
      "id": "missing-x-frame-options",
      "message": "Отсутствует заголовок X-Frame-Options",
      "severity": "low",
      "type": "regex",
      "pattern": "res\\.setHeader\\s*\\([^)]*X-Frame-Options",
      "flags": "gi",
      "recommendation": "Установите X-Frame-Options: DENY или SAMEORIGIN",
      "languages": ["javascript", "typescript", "python", "go"]
    },
    {
      "id": "privileged-container",
      "message": "Контейнер запущен с privileged: true",
      "severity": "critical",
      "type": "regex",
      "pattern": "privileged\\s*:\\s*true",
      "flags": "gi",
      "recommendation": "Установите privileged: false. Используйте securityContext.capabilities",
      "languages": ["yaml"]
    },
    {
      "id": "docker-root-user",
      "message": "Контейнер запускается с привилегиями root",
      "severity": "high",
      "type": "regex",
      "pattern": "(FROM\\s+[^\\n]+\\n(?!.*USER))",
      "flags": "gi",
      "recommendation": "Добавьте в Dockerfile: USER 1000 (не-root пользователь)",
      "languages": ["dockerfile"]
    },
    {
      "id": "docker-secrets",
      "message": "В Dockerfile обнаружены потенциальные секреты",
      "severity": "critical",
      "type": "regex",
      "pattern": "(ENV\\s+(PASSWORD|SECRET|TOKEN|KEY|API_KEY)\\s*=\\s*[^\\\\\\n]+|COPY\\s+.*\\.(pem|key|secret))",
      "flags": "gi",
      "recommendation": "Никогда не копируйте секреты в образ. Используйте Docker secrets",
      "languages": ["dockerfile"]
    },
    {
      "id": "public-s3-bucket",
      "message": "S3 бакет имеет публичный доступ",
      "severity": "critical",
      "type": "regex",
      "pattern": "acl\\s*=\\s*[\"']public-read",
      "flags": "gi",
      "recommendation": "Установите acl = \"private\" и используйте bucket policies",
      "languages": ["terraform", "hcl"]
    },
    {
      "id": "cicd-secrets",
      "message": "Обнаружены хардкод секреты в CI/CD конфигурации",
      "severity": "critical",
      "type": "regex",
      "pattern": "(GITHUB_TOKEN|AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|AZURE_CREDENTIALS|DOCKER_PASSWORD|NPM_TOKEN)\\s*=\\s*[\"'][^\"']+[\"']",
      "flags": "gi",
      "recommendation": "Используйте CI/CD Secrets или Variables",
      "languages": ["yaml"]
    },
    {
      "id": "debug-code-left",
      "message": "Отладочный вывод остался в production коде",
      "severity": "low",
      "type": "regex",
      "pattern": "console\\.(log|debug|info|warn|error|trace)\\s*\\(",
      "flags": "gi",
      "recommendation": "Удалите отладочный вывод из production кода или используйте условное логирование",
      "languages": ["javascript", "typescript", "python", "go", "java"]
    },
    {
      "id": "mass-assignment",
      "message": "Обнаружена уязвимость массового присваивания",
      "severity": "high",
      "type": "regex",
      "pattern": "(Model\\.create\\(req\\.body|Model\\.update\\(req\\.body|fill\\(request\\.all\\(\\)|setAttributes\\(params|update_attributes\\(params)",
      "flags": "gi",
      "recommendation": "Используйте белые списки для разрешенных полей",
      "languages": ["javascript", "typescript", "python", "ruby", "php"]
    },
    {
      "id": "graphql-batch-query",
      "message": "GraphQL позволяет выполнять множество запросов без ограничений",
      "severity": "high",
      "type": "regex",
      "pattern": "query\\s*{[\\s\\S]*query\\s*{",
      "flags": "gi",
      "recommendation": "Ограничьте глубину и сложность GraphQL запросов",
      "languages": ["graphql"]
    },
    {
      "id": "insecure-cookie-config",
      "message": "Небезопасная конфигурация cookie",
      "severity": "medium",
      "type": "regex",
      "pattern": "cookie\\s*\\([^)]*(?!(Secure|HttpOnly|SameSite))",
      "flags": "gi",
      "recommendation": "Установите флаги Secure, HttpOnly и SameSite=Strict для cookies",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "todo-comment",
      "message": "Найден комментарий TODO или FIXME",
      "severity": "info",
      "type": "regex",
      "pattern": "(\\/\\/|#|\\/\\*)\\s*(TODO|FIXME|XXX|HACK|BUG)",
      "flags": "gi",
      "recommendation": "Выполните задачу перед развертыванием в production",
      "languages": ["all"]
    }
  ]
}