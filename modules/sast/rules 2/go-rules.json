{
  "name": "Go SAST Rules",
  "version": "1.0.0",
  "description": "Security rules for Go",
  "rules": [
    {
      "id": "go/no-exec",
      "message": "Command execution detected",
      "severity": "high",
      "type": "pattern",
      "pattern": "exec.Command",
      "recommendation": "Validate and sanitize command inputs",
      "languages": ["go"]
    },
    {
      "id": "go/weak-hash",
      "message": "Weak hash function detected",
      "severity": "medium",
      "type": "pattern",
      "pattern": "md5.",
      "recommendation": "Use SHA-256 or stronger hashing",
      "languages": ["go"]
    },
    {
      "id": "go/no-tls",
      "message": "Non-HTTPS connection detected",
      "severity": "high",
      "type": "pattern",
      "pattern": "http://",
      "recommendation": "Use HTTPS instead of HTTP",
      "languages": ["go"]
    },
    {
      "id": "go/secure-tls",
      "message": "TLS verification disabled",
      "severity": "critical",
      "type": "pattern",
      "pattern": "InsecureSkipVerify:true",
      "recommendation": "Enable TLS certificate verification",
      "languages": ["go"]
    },
    {
      "id": "go/sql-injection",
      "message": "Possible SQL injection",
      "severity": "critical",
      "type": "pattern",
      "pattern": "db.Query(",
      "recommendation": "Use prepared statements",
      "languages": ["go"]
    },
    {
      "id": "go/jwt-hardcoded",
      "message": "Hardcoded JWT secret detected",
      "severity": "high",
      "type": "pattern",
      "pattern": "jwt.NewWithClaims",
      "recommendation": "Use environment variables for secrets",
      "languages": ["go"]
    },
    {
      "id": "go/path-traversal",
      "message": "Possible path traversal",
      "severity": "high",
      "type": "pattern",
      "pattern": "filepath.Join",
      "recommendation": "Validate and sanitize file paths",
      "languages": ["go"]
    },
    {
      "id": "go/hardcoded-secrets",
      "message": "Hardcoded secret detected",
      "severity": "high",
      "type": "regex",
      "pattern": "(password|secret|token|key|apiKey)\\s*:?=\\s*[\"'][^\"']+[\"']",
      "recommendation": "Use environment variables",
      "languages": ["go"]
    },
    {
      "id": "go/no-timeout",
      "message": "HTTP client without timeout",
      "severity": "medium",
      "type": "pattern",
      "pattern": "http.Client",
      "recommendation": "Set appropriate Timeout values",
      "languages": ["go"]
    },
    {
      "id": "go/no-goroutine-leak",
      "message": "Potential goroutine leak",
      "severity": "medium",
      "type": "pattern",
      "pattern": "go ",
      "recommendation": "Ensure goroutines are properly managed with channels or WaitGroups",
      "languages": ["go"]
    },
    {
      "id": "go/no-yaml",
      "message": "Unsafe YAML deserialization",
      "severity": "high",
      "type": "pattern",
      "pattern": "yaml.Unmarshal",
      "recommendation": "Use yaml.UnmarshalStrict for untrusted input",
      "languages": ["go"]
    },
    {
      "id": "go/rand",
      "message": "Use of math/rand for security purposes",
      "severity": "high",
      "type": "pattern",
      "pattern": "rand.Int",
      "recommendation": "Use crypto/rand for security-sensitive operations",
      "languages": ["go"]
    },
    {
      "id": "go/sprintf-query",
      "message": "SQL query built with Sprintf",
      "severity": "critical",
      "type": "pattern",
      "pattern": "fmt.Sprintf",
      "recommendation": "Use prepared statements to prevent SQL injection",
      "languages": ["go"]
    }
  ]
}