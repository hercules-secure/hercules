{
  "name": "SAST Rules",
  "version": "1.0.0",
  "description": "Security rules for JavaScript/TypeScript",
  "rules": [
    {
      "id": "javascript/hardcoded-credentials",
      "message": "Hardcoded credentials detected",
      "severity": "critical",
      "type": "regex",
      "pattern": "(user|username|login|pass|password|pwd)\\s*[=:]\\s*['\"]?[a-zA-Z0-9_-]+['\"]?",
      "recommendation": "Use environment variables or secure vault",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "javascript/hardcoded-strings",
      "message": "Hardcoded string literal - possible credential",
      "severity": "medium",
      "type": "regex",
      "pattern": "=\\s*['\"][a-zA-Z0-9_-]+['\"]",
      "recommendation": "Consider if this should be configurable",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "javascript/no-plaintext-secrets",
      "message": "Plaintext secret in code",
      "severity": "high",
      "type": "regex",
      "pattern": "(admin|root|master|secret|token|key|password)[\\s]*[=:][\\s]*[a-zA-Z0-9_-]+",
      "recommendation": "Never hardcode secrets - use environment variables",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "security/no-eval",
      "message": "Avoid using eval() due to security risks",
      "severity": "critical",
      "type": "pattern",
      "pattern": "eval(",
      "recommendation": "Use Function constructor or JSON.parse for dynamic code",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "security/no-child-process",
      "message": "Dangerous child_process execution",
      "severity": "high",
      "type": "pattern",
      "pattern": "child_process.exec(",
      "recommendation": "Use execFile or validate/sanitize input",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "best-practice/no-console-log",
      "message": "Console.log should not be used in production",
      "severity": "low",
      "type": "pattern",
      "pattern": "console.log(",
      "recommendation": "Use proper logging library with log levels",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "style/todo-comment",
      "message": "TODO comment found",
      "severity": "info",
      "type": "regex",
      "pattern": "\\/\\/\\s*TODO|\\/\\*\\s*TODO",
      "recommendation": "Address before production deployment",
      "languages": ["javascript", "typescript"]
    }
  ]
}