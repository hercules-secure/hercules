  "message": "Old Spring Framework version with known vulnerabilities",
  "severity": "high",
  "type": "regex",
  "pattern": "org\\.springframework:spring-(core|context|webmvc):5\\.2\\.(0|1[0-9]|20)\\.RELEASE",
  "recommendation": "Upgrade to Spring 5.2.22 or higher",
  "languages": ["config"]
},
{
  "id": "config/gradle-jackson",
  "message": "Vulnerable Jackson Databind version",
  "severity": "high",
  "type": "regex",
  "pattern": "com\\.fasterxml\\.jackson\\.core:jackson-databind:2\\.10\\.[0-9.]+",
  "recommendation": "Upgrade to Jackson 2.13.4 or higher",
  "languages": ["config"]
},
{
  "id": "config/gradle-struts",
  "message": "Vulnerable Struts2 version",
  "severity": "critical",
  "type": "regex",
  "pattern": "org\\.apache\\.struts:struts2-core:2\\.5\\.(0|1[0-9]|2[0-6])",
  "recommendation": "Upgrade to Struts 2.5.30 or higher",
  "languages": ["config"]
},
{
  "id": "config/gradle-tomcat",
  "message": "Vulnerable Tomcat version",
  "severity": "high",
  "type": "regex",
  "pattern": "org\\.apache\\.tomcat:tomcat-(catalina|embed-core):8\\.5\\.[0-9]+",
  "recommendation": "Upgrade to Tomcat 9.0.80 or higher",
  "languages": ["config"]
},
{
  "id": "config/gradle-fileupload",
  "message": "Vulnerable Commons FileUpload version",
  "severity": "high",
  "type": "regex",
  "pattern": "commons-fileupload:commons-fileupload:1\\.3\\.[0-9]+",
  "recommendation": "Upgrade to Commons FileUpload 1.5 or higher",
  "languages": ["config"]
},
{
  "id": "config/gradle-mysql",
  "message": "Old MySQL Connector version",
  "severity": "medium",
  "type": "regex",
  "pattern": "mysql:mysql-connector-java:5\\.1\\.[0-9]+",
  "recommendation": "Upgrade to MySQL Connector 8.0.33",
  "languages": ["config"]
}
  ]
}