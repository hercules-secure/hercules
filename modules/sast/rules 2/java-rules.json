{
  "name": "SAST Rules",
  "version": "1.0.0",
  "description": "Security rules for Java",
  "rules": [
    {
      "id": "java/sql-injection",
      "message": "Potential SQL injection - use prepared statements",
      "severity": "critical",
      "type": "regex",
      "pattern": "(Statement\\.executeQuery|Statement\\.executeUpdate|Statement\\.execute)\\(.*\\+.*\\)",
      "recommendation": "Use PreparedStatement with parameterized queries",
      "languages": ["java"]
    },
    {
      "id": "java/command-injection",
      "message": "Command injection vulnerability",
      "severity": "critical",
      "type": "regex",
      "pattern": "(Runtime\\.exec|ProcessBuilder)\\(.*\\+.*\\)",
      "recommendation": "Avoid Runtime.exec with user input; use ProcessBuilder with sanitization",
      "languages": ["java"]
    },
    {
      "id": "java/xxe",
      "message": "XXE vulnerability detected",
      "severity": "critical",
      "type": "regex",
      "pattern": "(setFeature.*true.*external-general-entities|setExpandEntityReferences\\(true\\))",
      "recommendation": "Disable external entity expansion",
      "languages": ["java"]
    },
    {
      "id": "java/open-redirect",
      "message": "Open redirect vulnerability",
      "severity": "high",
      "type": "regex",
      "pattern": "sendRedirect\\(.*(getParameter|getQueryString)",
      "recommendation": "Validate and whitelist redirect URLs",
      "languages": ["java"]
    },
    {
      "id": "java/weak-tls",
      "message": "Weak TLS version detected",
      "severity": "high",
      "type": "regex",
      "pattern": "SSLContext\\.getInstance\\([\"'](TLSv1|SSLv3)[\"']\\)",
      "recommendation": "Use TLSv1.2 or higher",
      "languages": ["java"]
    },
    {
      "id": "java/hardcoded-secrets",
      "message": "Hardcoded secret detected",
      "severity": "high",
      "type": "regex",
      "pattern": "(password|secret|token|key|apiKey|aws_secret|access_key)\\s*=\\s*[\"'][^\"']{8,}[\"']",
      "recommendation": "Use environment variables or secrets manager",
      "languages": ["java"]
    },
    {
      "id": "java/ldap-injection",
      "message": "LDAP injection vulnerability",
      "severity": "critical",
      "type": "regex",
      "pattern": "search\\(.*\\+.*\\)",
      "recommendation": "Use proper escaping or avoid concatenation",
      "languages": ["java"]
    },
    {
      "id": "java/xpath-injection",
      "message": "XPath injection vulnerability",
      "severity": "critical",
      "type": "regex",
      "pattern": "evaluate\\(.*\\+.*\\)",
      "recommendation": "Use parameterized XPath queries",
      "languages": ["java"]
    },
    {
      "id": "java/insecure-deserialization",
      "message": "Insecure deserialization",
      "severity": "critical",
      "type": "regex",
      "pattern": "ObjectInputStream\\.readObject\\(",
      "recommendation": "Avoid deserializing untrusted data",
      "languages": ["java"]
    },
    {
      "id": "java/jwt-none-algorithm",
      "message": "JWT with 'none' algorithm detected",
      "severity": "critical",
      "type": "regex",
      "pattern": "SignatureAlgorithm\\.NONE",
      "recommendation": "Always use a secure signing algorithm",
      "languages": ["java"]
    },
    {
      "id": "java/sensitive-data-logging",
      "message": "Sensitive data might be logged",
      "severity": "medium",
      "type": "regex",
      "pattern": "(logger\\.|System\\.out\\.println).*(password|credit|ssn|token|secret)",
      "recommendation": "Avoid logging sensitive information",
      "languages": ["java"]
    },
    {
      "id": "java/path-traversal",
      "message": "Path traversal vulnerability",
      "severity": "high",
      "type": "regex",
      "pattern": "(FileInputStream|FileOutputStream|FileReader|FileWriter)\\(.*\\+.*\\)",
      "recommendation": "Validate file paths and use whitelist",
      "languages": ["java"]
    },
    {
      "id": "java/ssrf",
      "message": "Server-Side Request Forgery (SSRF) vulnerability",
      "severity": "high",
      "type": "regex",
      "pattern": "new URL\\(.*getParameter.*\\)",
      "recommendation": "Validate and whitelist URLs",
      "languages": ["java"]
    },
    {
      "id": "java/weak-random",
      "message": "Weak random number generator",
      "severity": "medium",
      "type": "regex",
      "pattern": "new Random\\(|Random\\.nextInt",
      "recommendation": "Use SecureRandom for security-sensitive operations",
      "languages": ["java"]
    },
    {
      "id": "java/smtp-injection",
      "message": "SMTP injection vulnerability",
      "severity": "high",
      "type": "regex",
      "pattern": "Transport\\.send\\(",
      "recommendation": "Validate email inputs",
      "languages": ["java"]
    },
    {
      "id": "java/weak-encryption",
      "message": "Weak encryption algorithm detected",
      "severity": "high",
      "type": "regex",
      "pattern": "(DES|DESede|RC2|RC4|Blowfish)\\.|getInstance\\([\"'](DES|DESede|RC2|RC4|Blowfish)",
      "recommendation": "Use AES with GCM mode",
      "languages": ["java"]
    },
    {
      "id": "java/weak-hash",
      "message": "Weak hash function detected",
      "severity": "medium",
      "type": "regex",
      "pattern": "(MD5|SHA-?1)",
      "recommendation": "Use SHA-256 or stronger hashing",
      "languages": ["java"]
    },
    {
      "id": "java/ecb-mode",
      "message": "ECB encryption mode is insecure",
      "severity": "high",
      "type": "regex",
      "pattern": "/ECB/|getInstance\\([\"'].*/ECB/",
      "recommendation": "Use GCM or CBC mode with random IV",
      "languages": ["java"]
    },
    {
      "id": "config/dependency-log4j",
      "message": "Vulnerable Log4j version detected (Log4Shell)",
      "severity": "critical",
      "type": "regex",
      "pattern": "<version>2\\.(0|1[0-7]|14)\\.[0-9]+<\\/version>",
      "recommendation": "Upgrade to Log4j 2.17.1 or higher",
      "languages": ["config"]
    },
    {
      "id": "config/dependency-spring",
      "message": "Old Spring Framework version with known vulnerabilities",
      "severity": "high",
      "type": "regex",
      "pattern": "<version>5\\.2\\.(0|1[0-9]|20)\\.RELEASE<\\/version>",
      "recommendation": "Upgrade to Spring 5.2.22 or higher",
      "languages": ["config"]
    },
    {
      "id": "config/dependency-jackson",
      "message": "Vulnerable Jackson Databind version",
      "severity": "high",
      "type": "regex",
      "pattern": "<version>2\\.10\\.[0-9.]+<\\/version>",
      "recommendation": "Upgrade to Jackson 2.13.4 or higher",
      "languages": ["config"]
    },
    {
      "id": "config/dependency-struts",
      "message": "Vulnerable Struts2 version",
      "severity": "critical",
      "type": "regex",
      "pattern": "<version>2\\.5\\.(0|1[0-9]|2[0-6])<\\/version>",
      "recommendation": "Upgrade to Struts 2.5.30 or higher",
      "languages": ["config"]
    },
    {
      "id": "config/dependency-tomcat",
      "message": "Vulnerable Tomcat version",
      "severity": "high",
      "type": "regex",
      "pattern": "<version>8\\.5\\.[0-9]+<\\/version>",
      "recommendation": "Upgrade to Tomcat 9.0.80 or higher",
      "languages": ["config"]
    },
    {
      "id": "config/dependency-fileupload",
      "message": "Vulnerable Commons FileUpload version",
      "severity": "high",
      "type": "regex",
      "pattern": "<version>1\\.3\\.[0-9]+<\\/version>",
      "recommendation": "Upgrade to Commons FileUpload 1.5 or higher",
      "languages": ["config"]
    },
    {
      "id": "config/dependency-mysql",
      "message": "Old MySQL Connector version",
      "severity": "medium",
      "type": "regex",
      "pattern": "<version>5\\.1\\.[0-9]+<\\/version>",
      "recommendation": "Upgrade to MySQL Connector 8.0.33",
      "languages": ["config"]
    },
    {
      "id": "config/password",
      "message": "Hardcoded password detected in configuration",
      "severity": "critical",
      "type": "regex",
      "pattern": "(password|pass|pwd)\\s*[=:]\\s*['\"]?[^'\"\\s]+['\"]?",
      "recommendation": "Use environment variables or secrets manager",
      "languages": ["config"]
    },
    {
      "id": "config/api_key",
      "message": "API key exposed in configuration",
      "severity": "high",
      "type": "regex",
      "pattern": "(api[_-]?key|apikey|api_secret|api_token)\\s*[=:]\\s*['\"]?[^'\"\\s]+['\"]?",
      "recommendation": "Store API keys in environment variables",
      "languages": ["config"]
    },
    {
      "id": "config/token",
      "message": "Authentication token in plain text",
      "severity": "high",
      "type": "regex",
      "pattern": "(token|jwt|auth_token|access_token|refresh_token)\\s*[=:]\\s*['\"]?[^'\"\\s]+['\"]?",
      "recommendation": "Use secure token storage or environment variables",
      "languages": ["config"]
    },
    {
      "id": "config/aws_key",
      "message": "AWS access key detected",
      "severity": "critical",
      "type": "regex",
      "pattern": "AKIA[0-9A-Z]{16}",
      "recommendation": "Use AWS IAM roles or environment variables",
      "languages": ["config"]
    },
    {
      "id": "config/private_key",
      "message": "Private key found in configuration",
      "severity": "critical",
      "type": "regex",
      "pattern": "-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----",
      "recommendation": "Store private keys in secure vault with proper permissions",
      "languages": ["config"]
    },
    {
      "id": "config/url_credentials",
      "message": "URL contains embedded credentials",
      "severity": "high",
      "type": "regex",
      "pattern": "(https?|ftp)://[^:]+:[^@]+@",
      "recommendation": "Use environment variables for credentials",
      "languages": ["config"]
    },
    {
      "id": "config/jwt_token",
      "message": "JWT token detected in configuration",
      "severity": "high",
      "type": "regex",
      "pattern": "eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+",
      "recommendation": "Never commit JWT tokens - use environment variables",
      "languages": ["config"]
    },
    {
      "id": "config/db_connection",
      "message": "Database connection string with credentials",
      "severity": "critical",
      "type": "regex",
      "pattern": "(mongodb|postgresql|mysql|redis)://[^:]+:[^@]+@",
      "recommendation": "Use environment variables for database credentials",
      "languages": ["config"]
    },
    {
  "id": "config/gradle-log4j",
  "message": "Vulnerable Log4j version detected (Log4Shell)",
  "severity": "critical",
  "type": "regex",
  "pattern": "org\\.apache\\.logging\\.log4j:log4j-core:2\\.(0|1[0-7]|14)\\.[0-9]+",
  "recommendation": "Upgrade to Log4j 2.17.1 or higher",
  "languages": ["config"]
},
{
