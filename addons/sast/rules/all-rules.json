{
  "name": "Hercules Security Rules",
  "version": "4.0.0",
  "description": "Оптимизированные правила безопасности с группировкой по категориям",
  "categories": {
    "credentials": "Учетные данные и секреты",
    "injection": "Инъекции (SQL, Command, LDAP, NoSQL)",
    "crypto": "Криптография и шифрование",
    "ssrf": "SSRF и безопасность сети",
    "iac": "Infrastructure as Code (Kubernetes, Terraform, Docker)",
    "config": "Конфигурация и логирование",
    "rate-limit": "Rate Limiting и DoS защита",
    "memory": "Безопасность памяти (C/C++)",
    "owasp": "OWASP Top 10"
  },
  "rules": [
    {
      "id": "hardcoded-credentials",
      "category": "credentials",
      "message": "Обнаружены жестко закодированные учетные данные",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:password|pass|pwd|secret|api[_-]?key|token|access[_-]?token|refresh[_-]?token)\\s*[=:]\\s*['\"`][^'\"`\\s]{6,}['\"`]",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения или менеджер секретов",
      "languages": ["javascript", "typescript", "python", "java", "php", "ruby", "go", "csharp"]
    },
    {
      "id": "hardcoded-db-connection",
      "category": "credentials",
      "message": "Строка подключения к БД содержит пароль",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:mongodb|postgresql|mysql|redis|mongodb\\+srv):\\/\\/[^\\s'\"]+:[^\\s'\"]+@",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения для DATABASE_URL",
      "languages": ["javascript", "typescript", "python", "go", "java", "yaml", "env"]
    },
    {
      "id": "hardcoded-aws-credentials",
      "category": "credentials",
      "message": "AWS ключи доступа захардкожены",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:AKIA|ASIA)[0-9A-Z]{16}",
      "flags": "gi",
      "recommendation": "Используйте IAM роли или AWS Secrets Manager",
      "languages": ["javascript", "typescript", "python", "go", "java", "yaml", "terraform", "env"]
    },
    {
      "id": "private-key-exposure",
      "category": "credentials",
      "message": "Обнаружен приватный ключ",
      "severity": "critical",
      "type": "regex",
      "pattern": "-----BEGIN (?:RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY-----",
      "flags": "gi",
      "recommendation": "Храните приватные ключи в защищенном хранилище",
      "languages": ["all"]
    },
    {
      "id": "jwt-token-exposure",
      "category": "credentials",
      "message": "Обнаружен JWT токен",
      "severity": "high",
      "type": "regex",
      "pattern": "eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+",
      "flags": "gi",
      "recommendation": "Используйте переменные окружения для JWT токенов",
      "languages": ["all"]
    },
    {
      "id": "hardcoded-crypto-key",
      "category": "credentials",
      "message": "Криптографический ключ захардкожен",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:privateKey|secretKey|apiSecret|signingKey|encryptionKey|hmacSecret)\\s*=\\s*['\"`][A-Za-z0-9+/=]{32,}['\"`]",
      "flags": "gi",
      "recommendation": "Используйте KMS (AWS KMS, GCP KMS, Azure Key Vault, HashiCorp Vault)",
      "languages": ["all"]
    },
    {
      "id": "sql-injection",
      "category": "injection",
      "message": "Потенциальная SQL инъекция (A03:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:execute|query|exec|raw)\\s*\\(\\s*['\"`][^'\"`]*\\+",
      "flags": "gi",
      "recommendation": "Используйте параметризованные запросы или ORM",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp"]
    },
    {
      "id": "command-injection",
      "category": "injection",
      "message": "Потенциальная инъекция команд (A03:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:exec|system|popen|Runtime\\.exec|subprocess\\.call|os\\.system)\\s*\\([^)]*\\+(?:req|request|params|input|data)",
      "flags": "gi",
      "recommendation": "Избегайте выполнения команд с пользовательским вводом",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "nosql-injection",
      "category": "injection",
      "message": "Потенциальная NoSQL инъекция",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:\\$where|\\$regex|\\$ne|\\$gt|\\$lt|\\$in|\\$nin|\\$or)\\s*:[^}]*(?:req\\.|params\\.|query\\.|body\\.)",
      "flags": "gi",
      "recommendation": "Санируйте входные данные, используйте параметризацию",
      "languages": ["javascript", "typescript", "python", "java", "go", "csharp"]
    },
    {
      "id": "ldap-injection",
      "category": "injection",
      "message": "Потенциальная LDAP инъекция",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:search\\s*\\([^)]*\\+|LdapContext\\s*\\([^)]*req\\.|ldap_search\\s*\\([^)]*\\+\\s*\\$_)",
      "flags": "gi",
      "recommendation": "Используйте экранирование LDAP специальных символов",
      "languages": ["java", "python", "csharp", "php", "go"]
    },
    {
      "id": "xxe-vulnerability",
      "category": "injection",
      "message": "XXE: парсинг XML с внешними сущностями",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:XMLReader|SAXParser|DocumentBuilder|XPathExpression|XmlDocument|XmlTextReader)\\s*\\([^)]*(?!(?:setFeature|FEATURE_SECURE_PROCESSING|DisableDtdProcessing))",
      "flags": "gi",
      "recommendation": "Отключите внешние сущности DTD",
      "languages": ["java", "csharp", "php", "python"]
    },
    {
      "id": "ssti-vulnerability",
      "category": "injection",
      "message": "Потенциальная Server-Side Template Injection",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:render_template_string|eval\\(.*template|compile\\(.*template|\\$\\{.*\\}\\$\\{|<\\.\\.\\s*\\$)",
      "flags": "gi",
      "recommendation": "Используйте изолированные песочницы или безопасные шаблонизаторы",
      "languages": ["python", "javascript", "typescript", "java", "php", "go"]
    },
    {
      "id": "ssrf-vulnerability",
      "category": "ssrf",
      "message": "SSRF: запрос к пользовательскому URL (A10:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:axios\\.(?:get|post|put|delete|request)|fetch|http\\.get|https\\.get|requests\\.get|urllib\\.request|HttpClient)\\(\\s*(?:req\\.query\\.\\w+|req\\.body\\.\\w+|req\\.params\\.\\w+|url|target|uri|endpoint)\\s*\\)",
      "flags": "gi",
      "recommendation": "Валидируйте URL по белому списку доменов",
      "languages": ["javascript", "typescript", "python", "java", "go", "csharp"]
    },
    {
      "id": "cloud-metadata-ssrf",
      "category": "ssrf",
      "message": "SSRF: доступ к облачным метаданным",
      "severity": "critical",
      "type": "regex",
      "pattern": "169\\.254\\.169\\.254|metadata\\.google\\.internal|100\\.100\\.100\\.200",
      "flags": "gi",
      "recommendation": "Блокируйте доступ к внутренним IP и облачным метаданным",
      "languages": ["all"]
    },
    {
      "id": "ssrf-file-protocol",
      "category": "ssrf",
      "message": "SSRF: доступ к file:// протоколу",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:fetch|axios\\.get|http\\.get|requests\\.get)\\s*\\(['\"`]file://",
      "flags": "gi",
      "recommendation": "Блокируйте file://, gopher://, dict:// протоколы",
      "languages": ["javascript", "typescript", "python", "java", "go"]
    },
    {
      "id": "open-redirect",
      "category": "ssrf",
      "message": "Потенциальный открытый редирект (A01:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:redirect|res\\.redirect|redirect_to)\\s*\\([^)]*(?:req|request|params|headers\\[['\"]host['\"]\\]|headers\\.host|return_to|next|callback)",
      "flags": "gi",
      "recommendation": "Валидируйте URL редиректа по белому списку",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp"]
    },
    {
      "id": "http-instead-https",
      "category": "ssrf",
      "message": "Использование HTTP вместо HTTPS (A02:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:fetch|axios|http\\.get|https\\.get|requests\\.get|urllib\\.request)\\s*\\([^)]*\\bhttp:\\/\\/(?!localhost|127\\.0\\.0\\.1|::1)",
      "flags": "gi",
      "recommendation": "Всегда используйте HTTPS в production окружении",
      "languages": ["javascript", "typescript", "python", "go", "java", "csharp", "php"]
    },
    {
      "id": "weak-cryptography",
      "category": "crypto",
      "message": "Слабый криптографический алгоритм (A02:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "\\b(?:MD5|SHA-?1|DES|RC4|RSA1024)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте AES-256-GCM, bcrypt, Argon2 или SHA-256",
      "languages": ["javascript", "typescript", "python", "java", "php", "go", "csharp", "ruby"]
    },
    {
      "id": "jwt-none-algorithm",
      "category": "crypto",
      "message": "JWT с алгоритмом 'none' - критическая уязвимость",
      "severity": "critical",
      "type": "regex",
      "pattern": "\"alg\"\\s*:\\s*\"none\"",
      "flags": "gi",
      "recommendation": "Запретите алгоритм 'none', всегда проверяйте подпись",
      "languages": ["all"]
    },
    {
      "id": "jwt-no-expiration",
      "category": "crypto",
      "message": "JWT без срока действия (exp)",
      "severity": "high",
      "type": "regex",
      "pattern": "jwt\\.sign\\([^)]*(?!(?:expiresIn|exp|expiration))",
      "flags": "gi",
      "recommendation": "Устанавливайте короткое время жизни JWT (15-60 минут)",
      "languages": ["javascript", "typescript", "python", "java", "go", "csharp", "php"]
    },
    {
      "id": "jwt-weak-secret",
      "category": "crypto",
      "message": "JWT с коротким/простым секретом",
      "severity": "high",
      "type": "regex",
      "pattern": "jwt\\.sign\\([^,]+,\\s*['\"`][a-zA-Z0-9]{,16}['\"`]",
      "flags": "gi",
      "recommendation": "Используйте секреты длиной от 32 символов",
      "languages": ["javascript", "typescript", "python", "java", "go", "php"]
    },
    {
      "id": "insecure-deserialization",
      "category": "owasp",
      "message": "Небезопасная десериализация (A08:2021)",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:pickle\\.loads|yaml\\.load\\(|unserialize|ObjectInputStream|readObject|XmlSerializer|BinaryFormatter)\\([^)]*(?!.*safe)",
      "flags": "gi",
      "recommendation": "Используйте JSON с валидацией схемы",
      "languages": ["python", "java", "php", "ruby", "csharp", "go"]
    },
    {
      "id": "xss-vulnerability",
      "category": "owasp",
      "message": "Потенциальная XSS уязвимость (A07:2021)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:innerHTML|outerHTML|document\\.write|insertAdjacentHTML)\\s*=\\s*(?:req|request|params|query|body|\\+.*input)",
      "flags": "gi",
      "recommendation": "Используйте textContent или DOMPurify",
      "languages": ["javascript", "typescript"]
    },
    {
      "id": "path-traversal",
      "category": "owasp",
      "message": "Потенциальный обход пути (Path Traversal)",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:fs\\.(?:readFile|writeFile|readdir|unlink|createReadStream|createWriteStream))\\s*\\([^)]*\\.\\./",
      "flags": "gi",
      "recommendation": "Валидируйте пути, используйте path.resolve()",
      "languages": ["javascript", "typescript", "python", "java", "php", "go"]
    },
    {
      "id": "mass-assignment",
      "category": "owasp",
      "message": "Массовое присваивание (A01:2021) - эскалация привилегий",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:Model\\.(?:create|update|insert|upsert)|\\w+\\.(?:save|update|patch|assignAttributes)\\s*\\(\\s*req\\.body|req\\.body\\s*(?:=|:)\\s*\\w+|Object\\.assign\\([^,]+,\\s*req\\.(?:body|query)|c\\.(?:Bind|ShouldBind|BindJSON)\\(&\\w+\\)|fields\\s*=\\s*['\"]__all__['\"])",
      "flags": "gi",
      "recommendation": "Используйте DTO с явными разрешенными полями",
      "languages": ["javascript", "typescript", "python", "ruby", "php", "java", "go", "csharp"]
    },
    {
      "id": "mass-assignment-critical-fields",
      "category": "owasp",
      "message": "КРИТИЧЕСКОЕ: Массовое присваивание полей привилегий",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?:Model\\.(?:create|update|insert)|\\w+\\.(?:save|update)\\s*\\(\\s*req\\.body|c\\.Bind\\(&\\w+\\)).{0,100}(?:isAdmin|is_admin|role|permissions|isRoot|superuser|access_level)",
      "flags": "gi",
      "recommendation": "Поля привилегий НИКОГДА не должны приходить из input",
      "languages": ["javascript", "typescript", "python", "ruby", "php", "java", "go", "csharp"]
    },
    {
      "id": "dangerous-code-execution",
      "category": "owasp",
      "message": "Использование eval() или аналогичных функций",
      "severity": "critical",
      "type": "regex",
      "pattern": "\\b(?:eval|Function)\\s*\\([^)]*(?:req|request|params|body|query|input)",
      "flags": "gi",
      "recommendation": "Избегайте динамического выполнения кода",
      "languages": ["javascript", "typescript", "python"]
    },
    {
      "id": "python-eval",
      "category": "owasp",
      "message": "Использование eval() или exec()",
      "severity": "critical",
      "type": "regex",
      "pattern": "\\b(?:eval|exec|compile)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте ast.literal_eval() или json.loads()",
      "languages": ["python"]
    },
    {
      "id": "python-pickle",
      "category": "owasp",
      "message": "Использование pickle для недоверенных данных",
      "severity": "critical",
      "type": "regex",
      "pattern": "pickle\\.(?:loads|load|Unpickler)\\s*\\(",
      "flags": "gi",
      "recommendation": "Используйте JSON или другие безопасные форматы",
      "languages": ["python"]
    },
    {
      "id": "python-subprocess-shell",
      "category": "owasp",
      "message": "shell=True в subprocess",
      "severity": "critical",
      "type": "regex",
      "pattern": "subprocess\\.(?:call|Popen|run|check_output)\\s*\\([^)]*shell\\s*=\\s*True",
      "flags": "gi",
      "recommendation": "Избегайте shell=True, передавайте аргументы списком",
      "languages": ["python"]
    },
    {
      "id": "python-yaml-load",
      "category": "owasp",
      "message": "yaml.load() без SafeLoader",
      "severity": "high",
      "type": "regex",
      "pattern": "yaml\\.load\\s*\\([^)]*(?!(?:SafeLoader|FullLoader|CSafeLoader))",
      "flags": "gi",
      "recommendation": "Всегда используйте yaml.safe_load()",
      "languages": ["python"]
    },
    {
      "id": "cpp-gets-buffer-overflow",
      "category": "memory",
      "message": "Использование gets() - переполнение буфера",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bgets\\s*\\(",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Используйте fgets(buffer, size, stdin)"
    },
    {
      "id": "cpp-strcpy-unsafe",
      "category": "memory",
      "message": "strcpy() не проверяет размер буфера",
      "severity": "high",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bstrcpy\\s*\\(",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Используйте strncpy() или std::string"
    },
    {
      "id": "cpp-strcat-unsafe",
      "category": "memory",
      "message": "strcat() не проверяет размер буфера",
      "severity": "high",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bstrcat\\s*\\(",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Используйте strncat() или std::string"
    },
    {
      "id": "cpp-sprintf-unsafe",
      "category": "memory",
      "message": "sprintf() не проверяет границы буфера",
      "severity": "high",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bsprintf\\s*\\(",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Используйте snprintf()"
    },
    {
      "id": "cpp-printf-user-input",
      "category": "memory",
      "message": "Форматная строка содержит опасные данные",
      "severity": "medium",
      "type": "regex",
      "pattern": "(?<!['\"`])(?:printf|fprintf|sprintf|snprintf)\\s*\\(\\s*[a-zA-Z_][a-zA-Z0-9_]*\\s*[,)]",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Используйте printf(\"%s\", userInput)"
    },
    {
      "id": "cpp-system-call",
      "category": "memory",
      "message": "Вызов system() с пользовательскими данными опасен",
      "severity": "high",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bsystem\\s*\\(",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Используйте exec*() семейство"
    },
    {
      "id": "cpp-delete-not-matched",
      "category": "memory",
      "message": "delete голого указателя - возможная утечка или double free",
      "severity": "medium",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bdelete\\s+(?!\\[\\])(?![^\\\"]*\\\"[^\\\"]*\\\")(?![^']*'[^']*')(?![^/]*//)(?![^\\*]*\\*[^\\*]*\\*/)(?!.*\\bunique_ptr\\b)(?!.*\\bshared_ptr\\b)",
      "flags": "gim",
      "languages": ["cpp"],
      "recommendation": "Замените голый delete на умные указатели или используйте delete[] для массивов"
    },
    {
      "id": "cpp-malloc-without-free",
      "category": "memory",
      "message": "malloc без free - утечка памяти",
      "severity": "high",
      "type": "regex",
      "pattern": "(?<![a-zA-Z0-9_`'\"])\\bmalloc\\s*\\([^;]+(?!.*\\bfree\\s*\\([^)]*\\))(?!.*pool->)(?!.*arena->)(?!.*alloca)",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Всегда освобождайте память через free() или используйте умные указатели"
    },
    {
      "id": "cpp-use-after-free",
      "category": "memory",
      "message": "Потенциальный use-after-free",
      "severity": "critical",
      "type": "regex",
      "pattern": "(?<!['\"`])\\bfree\\s*\\([^;]+\\).{0,100}(?<!\\/\\/)(?<!\\*)\\b(?:\\w+)->",
      "flags": "gi",
      "languages": ["c", "cpp"],
      "recommendation": "Обнуляйте указатели после free: ptr = NULL"
    },
    {
      "id": "cpp-bare-pointer-return",
      "category": "memory",
      "message": "Возврат сырого указателя может привести к утечке",
      "severity": "medium",
      "type": "regex",
      "pattern": "(?<!['\"`])\\*\\s*\\w+\\s*\\([^)]*\\)\\s*\\{[^}]{0,200}\\bnew\\b",
      "flags": "gi",
      "languages": ["cpp"],
      "recommendation": "Возвращайте std::unique_ptr или std::shared_ptr"
    },
    {
      "id": "go-race-condition",
      "category": "memory",
      "message": "Потенциальная гонка данных в Go",
      "severity": "high",
      "type": "regex",
      "pattern": "(?:(?:\\w+\\s*:?=)\\s*\\w+\\.\\w+\\s*\\{[^}]*\\}\\s*\\)?)\\s*go\\s+func\\s*\\(",
      "flags": "gi",
      "languages": ["go"],
      "recommendation": "Используйте sync.Mutex или каналы"
    },
    {
      "id": "race-condition-toctou",
      "category": "memory",
      "message": "TOCTOU уязвимость",
      "severity": "high",
      "type": "regex",
      "pattern": "if\\s*\\(fs\\.existsSync\\([^)]+\\)\\)\\s*\\{[^}]{0,100}fs\\.(?:readFile|writeFile|unlink|rename|chmod)",
      "flags": "gi",
      "languages": ["javascript", "typescript", "python", "go", "java", "csharp"],
      "recommendation": "Используйте атомарные операции"
    },
    {
      "id": "iac-tf-admin-permissions",
      "category": "iac",
      "message": "Административные привилегии в IAM",
      "severity": "critical",
      "type": "regex",
