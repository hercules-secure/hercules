[
  {
    "id": "command-injection",
    "category": "injection",
    "message": "Потенциальная инъекция команд (A03:2021)",
    "severity": "critical",
    "pattern": "(?:exec|system|popen|Runtime\\.exec|subprocess\\.call|os\\.system|std::process::Command)\\s*\\([^)]*\\+(?:req|request|params|input|data)",
    "flags": "gi",
    "recommendation": "Избегайте выполнения команд с пользовательским вводом",
    "languages": ["javascript", "typescript", "python", "java", "php", "go", "rust", "ruby"]
  },
  {
    "id": "sql-injection",
    "category": "injection",
    "message": "Потенциальная SQL инъекция (A03:2021)",
    "severity": "critical",
    "pattern": "(?:execute|query|exec|raw)\\s*\\(\\s*['\"`][^'\"`]*\\+",
    "flags": "gi",
    "recommendation": "Используйте параметризованные запросы или ORM",
    "languages": ["javascript", "typescript", "python", "java", "php", "go", "ruby", "csharp", "rust"]
  },
  {
    "id": "path-traversal",
    "category": "owasp",
    "message": "Потенциальный обход пути (Path Traversal)",
    "severity": "high",
    "pattern": "(?:fs\\.(?:readFile|writeFile|readdir|unlink|createReadStream|createWriteStream)|std::fs::(?:read|write|read_to_string|metadata)|std::fs::File::open)\\s*\\([^)]*\\.\\./",
    "flags": "gi",
    "recommendation": "Валидируйте пути, используйте path.resolve()",
    "languages": ["javascript", "typescript", "python", "java", "php", "go", "rust"]
  },
  {
    "id": "ssrf-vulnerability",
    "category": "ssrf",
    "message": "SSRF: запрос к пользовательскому URL (A10:2021)",
    "severity": "critical",
    "pattern": "(?:axios\\.(?:get|post|put|delete|request)|fetch|http\\.get|https\\.get|requests\\.get|urllib\\.request|HttpClient|reqwest::(?:get|post|put|delete|request))\\s*\\(\\s*(?:req\\.query\\.\\w+|req\\.body\\.\\w+|req\\.params\\.\\w+|url|target|uri|endpoint)\\s*\\)",
    "flags": "gi",
    "recommendation": "Валидируйте URL по белому списку доменов",
    "languages": ["javascript", "typescript", "python", "java", "go", "csharp", "rust"]
  },
  {
    "id": "insecure-deserialization",
    "category": "owasp",
    "message": "Небезопасная десериализация (A08:2021)",
    "severity": "critical",
    "pattern": "(?:pickle\\.loads|yaml\\.load\\(|unserialize|ObjectInputStream|readObject|XmlSerializer|BinaryFormatter|serde_json::from_str|serde_json::from_reader|bincode::deserialize)\\s*\\([^)]*(?!.*safe)",
    "flags": "gi",
    "recommendation": "Используйте JSON с валидацией схемы",
    "languages": ["python", "java", "php", "ruby", "csharp", "go", "rust"]
  },
  {
    "id": "hardcoded-credentials",
    "category": "credentials",
    "message": "Обнаружены жестко закодированные учетные данные",
    "severity": "critical",
    "pattern": "(?:password|pass|pwd|secret|api[_-]?key|token|access[_-]?token|refresh[_-]?token)\\s*[=:]\\s*['\"`][^'\"`\\s]{6,}['\"`]",
    "flags": "gi",
    "recommendation": "Используйте переменные окружения или менеджер секретов",
    "languages": ["javascript", "typescript", "python", "java", "php", "ruby", "go", "csharp", "rust"]
  },
  {
    "id": "log-sensitive-data",
    "category": "config",
    "message": "Логирование чувствительных данных (A09:2021)",
    "severity": "high",
    "pattern": "(?:console\\.log|logger\\.(?:info|debug|warn|error|log)|System\\.out\\.println|logging\\.info|println!|eprintln!)\\s*\\([^)]*(?:password|token|secret|api_key|authorization|cookie|credit_card)",
    "flags": "gi",
    "recommendation": "Никогда не логируйте чувствительные данные",
    "languages": ["javascript", "typescript", "python", "java", "go", "csharp", "php", "ruby", "rust"]
  },
  {
    "id": "race-condition-toctou",
    "category": "memory",
    "message": "TOCTOU уязвимость",
    "severity": "high",
    "pattern": "if\\s*\\(fs\\.existsSync\\([^)]+\\)\\)\\s*\\{[^}]{0,100}fs\\.(?:readFile|writeFile|unlink|rename|chmod)",
    "flags": "gi",
    "recommendation": "Используйте атомарные операции",
    "languages": ["javascript", "typescript", "python", "go", "java", "csharp", "rust"]
  },
  {
    "id": "bola-idor",
    "category": "authorization",
    "message": "BOLA/IDOR: прямая подстановка ID без проверки прав доступа",
    "severity": "critical",
    "pattern": "(?:@PathVariable|@PathParam|req\\.params\\.|req\\.query\\.|:id|:userId|:accountId|:documentId|:recordId)\\s*(?:[\\w]+)\\s*.*?(?:find|get|fetch|delete|update|save|select|where|findById|findOne|getById|deleteById|updateById)\\s*\\([^)]*\\{?[^}]*(?:id|userId|accountId)",
    "flags": "gi",
    "recommendation": "Всегда проверяйте права доступа",
    "languages": ["javascript", "typescript", "java", "python", "php", "go", "ruby", "csharp", "rust"]
  },
  {
    "id": "xss",
    "category": "injection",
    "message": "Потенциальная XSS уязвимость (A07:2021)",
    "severity": "high",
    "pattern": "(?:innerHTML|outerHTML|document\\.write|insertAdjacentHTML|dangerouslySetInnerHTML)\\s*=\\s*(?:req|request|params|query|body|\\+.*input)",
