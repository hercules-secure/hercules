# Финальный образ (легкий, без инструментов сборки)
FROM node:20-alpine

WORKDIR /app

# 1. Копируем package.json и устанавливаем только продакшен-зависимости
# Это делается первым для кэширования Docker (чтобы не переустанавливать их при каждом изменении кода)
COPY package*.json ./
RUN npm ci --only=production

# 2. Копируем все обфусцированные файлы и папки, которые подготовил скрипт
# Важно: все JS-файлы уже запутаны скриптом, поэтому мы просто переносим их
COPY . .

# 3. Открываем порт
EXPOSE 6565

# 4. Запускаем сервер в продакшен-режиме (как прописано в новом скрипте)
CMD ["npm", "run", "start:prod"]